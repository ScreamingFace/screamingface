{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "separate-pull-requests": true,
  "pull-request-title-pattern": "chore${scope}: release ${component} ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "refactor", "section": "Refactors" },
    { "type": "docs", "section": "Documentation" },
    { "type": "ci", "section": "Build / CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true }
  ],
  "packages": {
    "apps/aigateway": {
      "release-type": "python",
      "package-name": "aigateway",
      "component": "aigateway",
      "tag-separator": "-",
      "include-component-in-tag": true,
      "version-file": "apps/aigateway/pyproject.toml"
    },
    "packages/url4": {
      "release-type": "python",
      "package-name": "url4",
      "component": "url4",
      "tag-separator": "-",
      "include-component-in-tag": true,
      "version-file": "packages/url4/pyproject.toml"
    },
    "packages/screamingface": {
      "release-type": "python",
      "package-name": "screamingface",
      "component": "screamingface",
      "tag-separator": "-",
      "include-component-in-tag": true,
      "version-file": "packages/screamingface/pyproject.toml"
    },
    "apps/screamingface-engine": {
      "release-type": "python",
      "package-name": "screamingface-engine",
      "component": "screamingface-engine",
      "tag-separator": "-",
      "include-component-in-tag": true,
      "version-file": "apps/screamingface-engine/pyproject.toml"
    },
    "apps/scoreboard": {
      "release-type": "python",
      "package-name": "scoreboard",
      "component": "scoreboard",
      "tag-separator": "-",
      "include-component-in-tag": true,
      "version-file": "apps/scoreboard/pyproject.toml"
    },
    "apps/report-intake": {
      "release-type": "python",
      "package-name": "report-intake",
      "component": "report-intake",
      "tag-separator": "-",
      "include-component-in-tag": true,
      "version-file": "apps/report-intake/pyproject.toml"
    },
    "apps/aigateway-ui": {
      "package-name": "aigateway-ui",
      "component": "aigateway-ui",
      "tag-separator": "-",
      "include-component-in-tag": true
    }
  }
}
