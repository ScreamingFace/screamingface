{
  "$defs": {
    "EntropySource": {
      "additionalProperties": false,
      "description": "``{\"source\": \"entropy\", \"top_logprobs\": 1..20}`` (E4b part 3).\n\nThe value is the mean token entropy of each member's reply, in nats (the member reader).",
      "properties": {
        "source": {
          "const": "entropy",
          "title": "Source",
          "type": "string"
        },
        "top_logprobs": {
          "maximum": 20,
          "minimum": 1,
          "title": "Top Logprobs",
          "type": "integer"
        }
      },
      "required": [
        "source",
        "top_logprobs"
      ],
      "title": "EntropySource",
      "type": "object"
    },
    "LogprobSource": {
      "additionalProperties": false,
      "description": "``{\"source\": \"logprob\", \"form\": \"mean\" | \"sum\" | \"prob\"}`` (E4b part 3).\n\nThe value comes from each member's reply log-probabilities (the member reader), not from its\ntext.",
      "properties": {
        "form": {
          "enum": [
            "mean",
            "sum",
            "prob"
          ],
          "title": "Form",
          "type": "string"
        },
        "source": {
          "const": "logprob",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "form"
      ],
      "title": "LogprobSource",
      "type": "object"
    },
    "SignalWeights": {
      "additionalProperties": false,
      "description": "``weights: {\"signal\": key}``: each member's vote weight comes from the named signal.",
      "properties": {
        "signal": {
          "title": "Signal",
          "type": "string"
        }
      },
      "required": [
        "signal"
      ],
      "title": "SignalWeights",
      "type": "object"
    },
    "StepSpec": {
      "additionalProperties": false,
      "description": "One pipeline step: a pinned operator id and its args.",
      "properties": {
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "op": {
          "pattern": "^[a-z][a-z0-9_]{0,47}@[1-9][0-9]{0,5}$",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "args"
      ],
      "title": "StepSpec",
      "type": "object"
    },
    "VerbalizedSource": {
      "additionalProperties": false,
      "description": "``{\"source\": \"verbalized\", \"pattern\": str, \"ignore_case\"?: bool}`` (E4b part 3).\n\nThe pattern rules (length, RE2 compile, one group) are the source plugin's; the endpoint checks\nthem at plan time through ``registry.source``.",
      "properties": {
        "ignore_case": {
          "default": false,
          "title": "Ignore Case",
          "type": "boolean"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "source": {
          "const": "verbalized",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "pattern"
      ],
      "title": "VerbalizedSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``screamingface.combine-spec.v1``: every key required, ``null`` only where typed.",
  "properties": {
    "extract": {
      "anyOf": [
        {
          "$ref": "#/$defs/StepSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "members": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Members",
      "type": "array"
    },
    "normalize": {
      "anyOf": [
        {
          "$ref": "#/$defs/StepSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "reduce": {
      "$ref": "#/$defs/StepSpec"
    },
    "reducer": {
      "enum": [
        "vote",
        "median",
        "judge",
        "pick",
        "merge",
        "project",
        "rank",
        "concat",
        "filter",
        "mean"
      ],
      "title": "Reducer",
      "type": "string"
    },
    "schema": {
      "const": "screamingface.combine-spec.v1",
      "title": "Schema",
      "type": "string"
    },
    "select": {
      "$ref": "#/$defs/StepSpec"
    },
    "signals": {
      "anyOf": [
        {
          "additionalProperties": {
            "discriminator": {
              "mapping": {
                "entropy": "#/$defs/EntropySource",
                "logprob": "#/$defs/LogprobSource",
                "verbalized": "#/$defs/VerbalizedSource"
              },
              "propertyName": "source"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/VerbalizedSource"
              },
              {
                "$ref": "#/$defs/LogprobSource"
              },
              {
                "$ref": "#/$defs/EntropySource"
              }
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signals"
    },
    "weights": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "$ref": "#/$defs/SignalWeights"
        },
        {
          "type": "null"
        }
      ],
      "title": "Weights"
    }
  },
  "required": [
    "schema",
    "reducer",
    "members",
    "extract",
    "normalize",
    "reduce",
    "select",
    "weights"
  ],
  "title": "CombineSpec",
  "type": "object"
}
