{
  "$defs": {
    "ConsistencyMatch": {
      "additionalProperties": false,
      "description": "How a sample is compared with the member's answer (E4b part 7): the E4a stages.\n\nBoth are pinned operator ids, as in the spec's own steps; ``normalize`` may be null.",
      "properties": {
        "extract": {
          "$ref": "#/$defs/StepSpec"
        },
        "normalize": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepSpec"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "extract",
        "normalize"
      ],
      "title": "ConsistencyMatch",
      "type": "object"
    },
    "ConsistencySource": {
      "additionalProperties": false,
      "description": "``{\"source\": \"consistency\", \"n\": 1..32, \"temperature\": >= 0, \"match\": {...}}`` (E4b part 7).\n\nThe value is the fraction of a member's ``n`` extra calls (the context ``samples``) whose\nanswer matches the member's answer after ``match``. Every key is required.",
      "properties": {
        "match": {
          "$ref": "#/$defs/ConsistencyMatch"
        },
        "n": {
          "maximum": 32,
          "minimum": 1,
          "title": "N",
          "type": "integer"
        },
        "source": {
          "const": "consistency",
          "title": "Source",
          "type": "string"
        },
        "temperature": {
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "required": [
        "source",
        "n",
        "temperature",
        "match"
      ],
      "title": "ConsistencySource",
      "type": "object"
    },
    "EntropySource": {
      "additionalProperties": false,
      "description": "``{\"source\": \"entropy\", \"top_logprobs\": 1..20}`` (E4b part 3).\n\nThe value is the mean token entropy of each member's reply, in nats (the member reader).",
      "properties": {
        "source": {
          "const": "entropy",
          "title": "Source",
          "type": "string"
        },
        "top_logprobs": {
          "maximum": 20,
          "minimum": 1,
          "title": "Top Logprobs",
          "type": "integer"
        }
      },
      "required": [
        "source",
        "top_logprobs"
      ],
      "title": "EntropySource",
      "type": "object"
    },
    "GateSpec": {
      "additionalProperties": false,
      "description": "``gate``: keep the majority when ``observe cmp threshold`` holds (E4b part 5).\n\n``otherwise`` names the fallback that answers when the comparison is false. The fallback call\nitself is in the url4, not in the spec.",
      "properties": {
        "abstain_band": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstain Band"
        },
        "cmp": {
          "enum": [
            ">=",
            ">",
            "<=",
            "<"
          ],
          "title": "Cmp",
          "type": "string"
        },
        "observe": {
          "title": "Observe",
          "type": "string"
        },
        "otherwise": {
          "enum": [
            "abstain",
            "judge",
            "writer"
          ],
          "title": "Otherwise",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "observe",
        "cmp",
        "threshold",
        "otherwise"
      ],
      "title": "GateSpec",
      "type": "object"
    },
    "LogprobSource": {
      "additionalProperties": false,
      "description": "``{\"source\": \"logprob\", \"form\": \"mean\" | \"sum\" | \"prob\"}`` (E4b part 3).\n\nThe value comes from each member's reply log-probabilities (the member reader), not from its\ntext.",
      "properties": {
        "form": {
          "enum": [
            "mean",
            "sum",
            "prob"
          ],
          "title": "Form",
          "type": "string"
        },
        "source": {
          "const": "logprob",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "form"
      ],
      "title": "LogprobSource",
      "type": "object"
    },
    "NarrowSpec": {
      "additionalProperties": false,
      "description": "One narrow step before the main step: every key required, ``null`` only where typed.",
      "properties": {
        "extract": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "normalize": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "reduce": {
          "$ref": "#/$defs/StepSpec"
        },
        "select": {
          "$ref": "#/$defs/StepSpec"
        }
      },
      "required": [
        "extract",
        "normalize",
        "reduce",
        "select"
      ],
      "title": "NarrowSpec",
      "type": "object"
    },
    "SignalWeights": {
      "additionalProperties": false,
      "description": "``weights: {\"signal\": key}``: each member's vote weight comes from the named signal.",
      "properties": {
        "signal": {
          "title": "Signal",
          "type": "string"
        }
      },
      "required": [
        "signal"
      ],
      "title": "SignalWeights",
      "type": "object"
    },
    "StepSpec": {
      "additionalProperties": false,
      "description": "One pipeline step: a pinned operator id and its args.",
      "properties": {
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "op": {
          "pattern": "^[a-z][a-z0-9_]{0,47}@[1-9][0-9]{0,5}$",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "args"
      ],
      "title": "StepSpec",
      "type": "object"
    },
    "SumSource": {
      "additionalProperties": false,
      "description": "``{\"source\": \"sum\", \"coefficients\": {name: number}}`` (E4b part 6, ans:Q1).\n\nThe value is sum(coefficient x value) over the components, per member. The core computes it\n(``combine/signal_sum.py``), so it has no source plugin.",
      "properties": {
        "coefficients": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 7,
          "minProperties": 1,
          "title": "Coefficients",
          "type": "object"
        },
        "source": {
          "const": "sum",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "coefficients"
      ],
      "title": "SumSource",
      "type": "object"
    },
    "VerbalizedSource": {
      "additionalProperties": false,
      "description": "``{\"source\": \"verbalized\", \"pattern\": str, \"ignore_case\"?: bool}`` (E4b part 3).\n\nThe pattern rules (length, RE2 compile, one group) are the source plugin's; the endpoint checks\nthem at plan time through ``registry.source``.",
      "properties": {
        "ignore_case": {
          "default": false,
          "title": "Ignore Case",
          "type": "boolean"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "source": {
          "const": "verbalized",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "pattern"
      ],
      "title": "VerbalizedSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``screamingface.combine-spec.v1``: every key required, ``null`` only where typed.",
  "properties": {
    "extract": {
      "anyOf": [
        {
          "$ref": "#/$defs/StepSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/GateSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "members": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Members",
      "type": "array"
    },
    "narrow": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/NarrowSpec"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Narrow"
    },
    "normalize": {
      "anyOf": [
        {
          "$ref": "#/$defs/StepSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "reduce": {
      "$ref": "#/$defs/StepSpec"
    },
    "reducer": {
      "enum": [
        "vote",
        "median",
        "judge",
        "pick",
        "merge",
        "project",
        "rank",
        "concat",
        "filter",
        "mean"
      ],
      "title": "Reducer",
      "type": "string"
    },
    "schema": {
      "const": "screamingface.combine-spec.v1",
      "title": "Schema",
      "type": "string"
    },
    "select": {
      "$ref": "#/$defs/StepSpec"
    },
    "signals": {
      "anyOf": [
        {
          "additionalProperties": {
            "discriminator": {
              "mapping": {
                "consistency": "#/$defs/ConsistencySource",
                "entropy": "#/$defs/EntropySource",
                "logprob": "#/$defs/LogprobSource",
                "sum": "#/$defs/SumSource",
                "verbalized": "#/$defs/VerbalizedSource"
              },
              "propertyName": "source"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/VerbalizedSource"
              },
              {
                "$ref": "#/$defs/LogprobSource"
              },
              {
                "$ref": "#/$defs/EntropySource"
              },
              {
                "$ref": "#/$defs/SumSource"
              },
              {
                "$ref": "#/$defs/ConsistencySource"
              }
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signals"
    },
    "weights": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "$ref": "#/$defs/SignalWeights"
        },
        {
          "type": "null"
        }
      ],
      "title": "Weights"
    }
  },
  "required": [
    "schema",
    "reducer",
    "members",
    "extract",
    "normalize",
    "reduce",
    "select",
    "weights"
  ],
  "title": "CombineSpec",
  "type": "object"
}
