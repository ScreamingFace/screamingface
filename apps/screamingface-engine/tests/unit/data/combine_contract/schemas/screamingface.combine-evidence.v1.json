{
  "$defs": {
    "AnswerRecord": {
      "additionalProperties": false,
      "description": "One spec member, in author order.",
      "properties": {
        "member_id": {
          "title": "Member Id",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "empty",
                "not_numeric",
                "not_json",
                "field_missing",
                "too_large",
                "no_match",
                "missing",
                "no_votes",
                "cut_not_met",
                "output_missing",
                "gate_not_met",
                "in_band"
              ],
              "type": "string"
            },
            {
              "enum": [
                "no_signal",
                "no_weight",
                "not_selected"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "signals": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Signals",
          "type": "object"
        },
        "status": {
          "enum": [
            "answered",
            "fail",
            "excluded"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Weight"
        }
      },
      "required": [
        "member_id",
        "raw",
        "value",
        "status",
        "reason",
        "signals",
        "weight",
        "score"
      ],
      "title": "AnswerRecord",
      "type": "object"
    },
    "CutRecord": {
      "additionalProperties": false,
      "description": "The cut of a ``top_k@1`` step: keep the first ``k`` scored members in ``order``.",
      "properties": {
        "k": {
          "maximum": 256,
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "order": {
          "enum": [
            "max",
            "min"
          ],
          "title": "Order",
          "type": "string"
        }
      },
      "required": [
        "k",
        "order"
      ],
      "title": "CutRecord",
      "type": "object"
    },
    "FieldReadingRecord": {
      "additionalProperties": false,
      "description": "One field-level rule applied by a pick or merge reducer.",
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/JsonValue"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "field",
        "rule",
        "values",
        "result"
      ],
      "title": "FieldReadingRecord",
      "type": "object"
    },
    "GateRecord": {
      "additionalProperties": false,
      "description": "What the gate compared and which branch the step took (E4b part 5, ans:Q1).\n\n``passed`` and ``branch`` are null when the gate did not run (the vote found no answer); then\n``observed`` is null too (GR-I1). ``observed`` is also null when the gate ran and had no number.\nE4b part 6 (ans:Q2): ``branch`` \"band\" = the number was inside the closed ``abstain_band``, so\nthe step abstained with ``in_band`` and made no comparison (``passed`` null, P10).",
      "properties": {
        "abstain_band": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstain Band"
        },
        "branch": {
          "anyOf": [
            {
              "enum": [
                "majority",
                "fallback",
                "band"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Branch"
        },
        "cmp": {
          "enum": [
            ">=",
            ">",
            "<=",
            "<"
          ],
          "title": "Cmp",
          "type": "string"
        },
        "observe": {
          "title": "Observe",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed"
        },
        "otherwise": {
          "enum": [
            "abstain",
            "judge",
            "writer"
          ],
          "title": "Otherwise",
          "type": "string"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Passed"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "observe",
        "observed",
        "cmp",
        "threshold",
        "passed",
        "branch",
        "otherwise"
      ],
      "title": "GateRecord",
      "type": "object"
    },
    "JsonValue": {},
    "JudgeReadingRecord": {
      "additionalProperties": false,
      "description": "What the strict judge parse found: a label (``member_2``) or per-member scores.",
      "properties": {
        "parsed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            }
          ],
          "title": "Parsed"
        },
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "returns": {
          "enum": [
            "label",
            "scores"
          ],
          "title": "Returns",
          "type": "string"
        }
      },
      "required": [
        "raw",
        "returns",
        "parsed"
      ],
      "title": "JudgeReadingRecord",
      "type": "object"
    },
    "NarrowRecord": {
      "additionalProperties": false,
      "description": "What one narrow step did (E4b map-reduce surface, narrow.md \u00a74.2).\n\n``reduce`` and ``select`` are the pinned op ids of the step (a later ``filter@2`` is visible);\n``signal`` the key the step read (absent for a pattern filter); ``kept`` the members it chose,\nin author order (empty: the step abstained, and it is the last record); ``scores`` the step's\nscore of each live member that had one; ``cut`` and ``ranks`` only for a ``top_k@1`` step (the\npart 2 rules of ``top_k_ranks`` and ``CutRecord``). A key that is not set is absent.",
      "properties": {
        "cut": {
          "anyOf": [
            {
              "$ref": "#/$defs/CutRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kept": {
          "items": {
            "type": "string"
          },
          "title": "Kept",
          "type": "array"
        },
        "ranks": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ranks"
        },
        "reduce": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reduce"
        },
        "scores": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scores"
        },
        "select": {
          "title": "Select",
          "type": "string"
        },
        "signal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signal"
        }
      },
      "required": [
        "select",
        "kept"
      ],
      "title": "NarrowRecord",
      "type": "object"
    },
    "ResultRecord": {
      "additionalProperties": false,
      "description": "The computed answer of the step: a member's text, a built text, or an abstain.",
      "properties": {
        "member_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Member Id"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "no_votes",
                "cut_not_met",
                "output_missing",
                "gate_not_met",
                "in_band"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "status": {
          "enum": [
            "answered",
            "abstain"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "member_id",
        "value",
        "status",
        "reason"
      ],
      "title": "ResultRecord",
      "type": "object"
    },
    "SampleCountRecord": {
      "additionalProperties": false,
      "description": "One member's samples of the declared consistency source (E4b part 7, ans:Q4).\n\n``succeeded`` samples answered and ``failed`` did not; ``matched`` of the succeeded samples\ngave the member's answer. ``matched`` is null when the member has no value (CS-I4, CS-I5).",
      "properties": {
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "matched": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Matched"
        },
        "member_id": {
          "title": "Member Id",
          "type": "string"
        },
        "succeeded": {
          "minimum": 0,
          "title": "Succeeded",
          "type": "integer"
        }
      },
      "required": [
        "member_id",
        "matched",
        "succeeded",
        "failed"
      ],
      "title": "SampleCountRecord",
      "type": "object"
    },
    "SignalRecord": {
      "additionalProperties": false,
      "description": "The one signal the spec reads, and the order a reducer asked for (None: no order).",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "order": {
          "anyOf": [
            {
              "enum": [
                "max",
                "min"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Order"
        }
      },
      "required": [
        "key",
        "order"
      ],
      "title": "SignalRecord",
      "type": "object"
    },
    "TallyRowRecord": {
      "additionalProperties": false,
      "description": "One distinct value, its score and its holders in author order.",
      "properties": {
        "holders": {
          "items": {
            "type": "string"
          },
          "title": "Holders",
          "type": "array"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "score",
        "holders"
      ],
      "title": "TallyRowRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything one combine step decided, minus the answer text.",
  "properties": {
    "agreement": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Agreement"
    },
    "built": {
      "title": "Built",
      "type": "boolean"
    },
    "chosen": {
      "items": {
        "type": "string"
      },
      "title": "Chosen",
      "type": "array"
    },
    "consistency": {
      "anyOf": [
        {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/SampleCountRecord"
            },
            "type": "array"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consistency"
    },
    "cut": {
      "anyOf": [
        {
          "$ref": "#/$defs/CutRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "declared": {
      "anyOf": [
        {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Declared"
    },
    "dropped": {
      "title": "Dropped",
      "type": "integer"
    },
    "fields": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/FieldReadingRecord"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Fields"
    },
    "finish_reason": {
      "const": "stop",
      "title": "Finish Reason",
      "type": "string"
    },
    "gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/GateRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "judge": {
      "anyOf": [
        {
          "$ref": "#/$defs/JudgeReadingRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "answer",
        "selection",
        "projection"
      ],
      "title": "Kind",
      "type": "string"
    },
    "mean": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mean"
    },
    "median": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Median"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/AnswerRecord"
      },
      "title": "Members",
      "type": "array"
    },
    "narrow": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/NarrowRecord"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Narrow"
    },
    "operators": {
      "items": {
        "type": "string"
      },
      "title": "Operators",
      "type": "array"
    },
    "presentation_order": {
      "anyOf": [
        {
          "const": "author",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Presentation Order"
    },
    "reducer": {
      "enum": [
        "vote",
        "median",
        "judge",
        "pick",
        "merge",
        "project",
        "rank",
        "concat",
        "filter",
        "mean"
      ],
      "title": "Reducer",
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/ResultRecord"
    },
    "schema": {
      "const": "screamingface.combine-evidence.v1",
      "default": "screamingface.combine-evidence.v1",
      "title": "Schema",
      "type": "string"
    },
    "separator_collision": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Separator Collision"
    },
    "signal": {
      "anyOf": [
        {
          "$ref": "#/$defs/SignalRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "tally": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/TallyRowRecord"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tally"
    },
    "tie": {
      "title": "Tie",
      "type": "boolean"
    },
    "verifier": {
      "default": null,
      "title": "Verifier",
      "type": "null"
    }
  },
  "required": [
    "kind",
    "reducer",
    "operators",
    "members",
    "tally",
    "judge",
    "fields",
    "chosen",
    "built",
    "agreement",
    "tie",
    "median",
    "presentation_order",
    "separator_collision",
    "signal",
    "result",
    "dropped",
    "finish_reason"
  ],
  "title": "CombineEvidence",
  "type": "object"
}
