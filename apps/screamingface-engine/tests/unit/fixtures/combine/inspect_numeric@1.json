{
 "op": "inspect_numeric@1",
 "stage": "normalize",
 "cases": [
  {
   "name": "plain integer",
   "input": "1200",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "1200"
   }
  },
  {
   "name": "currency and thousands separator",
   "input": "$1,200.",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "1200"
   }
  },
  {
   "name": "five significant digits",
   "input": "123456",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "1.2346e+05"
   }
  },
  {
   "name": "five significant digits, next integer",
   "input": "123457",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "1.2346e+05"
   }
  },
  {
   "name": "vulgar fraction",
   "input": "½",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "0.5"
   }
  },
  {
   "name": "parentheses trimmed",
   "input": "(42)",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "42"
   }
  },
  {
   "name": "comma grouping",
   "input": "1,23",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "123"
   }
  },
  {
   "name": "leading point",
   "input": ".5",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "0.5"
   }
  },
  {
   "name": "exponent form",
   "input": "3.5e10",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "3.5e+10"
   }
  },
  {
   "name": "not a number",
   "input": "abc",
   "args": {},
   "expect": {
    "status": "not_numeric",
    "value": null
   }
  },
  {
   "name": "assignment is not a number",
   "input": "x=42",
   "args": {},
   "expect": {
    "status": "not_numeric",
    "value": null
   }
  },
  {
   "name": "empty",
   "input": "",
   "args": {},
   "expect": {
    "status": "not_numeric",
    "value": null
   }
  },
  {
   "name": "too large for a float",
   "input": "1e999",
   "args": {},
   "expect": {
    "status": "not_numeric",
    "value": null
   }
  }
 ]
}
