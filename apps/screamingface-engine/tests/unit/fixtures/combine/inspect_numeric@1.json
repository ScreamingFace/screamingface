{
 "op": "inspect_numeric@1",
 "stage": "normalize",
 "cases": [
  {"name": "plain integer", "args": {},
   "input": "1200",
   "expect": {"status": "voted", "value": "1200"}},
  {"name": "currency and thousands separator", "args": {},
   "input": "$1,200.",
   "expect": {"status": "voted", "value": "1200"}},
  {"name": "five significant digits", "args": {},
   "input": "123456",
   "expect": {"status": "voted", "value": "1.2346e+05"}},
  {"name": "five significant digits, next integer", "args": {},
   "input": "123457",
   "expect": {"status": "voted", "value": "1.2346e+05"}},
  {"name": "vulgar fraction", "args": {},
   "input": "½",
   "expect": {"status": "voted", "value": "0.5"}},
  {"name": "parentheses trimmed", "args": {},
   "input": "(42)",
   "expect": {"status": "voted", "value": "42"}},
  {"name": "comma grouping", "args": {},
   "input": "1,23",
   "expect": {"status": "voted", "value": "123"}},
  {"name": "leading point", "args": {},
   "input": ".5",
   "expect": {"status": "voted", "value": "0.5"}},
  {"name": "exponent form", "args": {},
   "input": "3.5e10",
   "expect": {"status": "voted", "value": "3.5e+10"}},
  {"name": "not a number", "args": {},
   "input": "abc",
   "expect": {"status": "not_numeric", "value": null}},
  {"name": "assignment is not a number", "args": {},
   "input": "x=42",
   "expect": {"status": "not_numeric", "value": null}},
  {"name": "empty", "args": {},
   "input": "",
   "expect": {"status": "not_numeric", "value": null}},
  {"name": "too large for a float", "args": {},
   "input": "1e999",
   "expect": {"status": "not_numeric", "value": null}}
 ]
}
