{
 "op": "project_field@1",
 "stage": "reduce",
 "cases": [
  {
   "name": "values of one field by member",
   "args": {
    "field": "summary"
   },
   "input": {
    "readings": [
     {
      "member": "member_1",
      "raw": "{\"summary\":\"a\"}",
      "value": "{\"summary\":\"a\"}",
      "status": "voted",
      "weight": null
     },
     {
      "member": "member_2",
      "raw": "{\"summary\":\"b\",\"x\":1}",
      "value": "{\"summary\":\"b\",\"x\":1}",
      "status": "voted",
      "weight": null
     },
     {
      "member": "member_3",
      "raw": "{\"x\":2}",
      "value": "{\"x\":2}",
      "status": "voted",
      "weight": null
     }
    ]
   },
   "expect": {
    "text": "{\"member_1\":\"a\",\"member_2\":\"b\"}",
    "fields": [
     {
      "field": "summary",
      "rule": "project",
      "values": {
       "member_1": "a",
       "member_2": "b"
      },
      "result": null
     }
    ]
   }
  },
  {
   "name": "null is absent",
   "args": {
    "field": "summary"
   },
   "input": {
    "readings": [
     {
