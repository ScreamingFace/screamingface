      "value": "{\"summary\":null}",
      "status": "voted",
      "weight": null
     },
     {
      "member": "member_2",
      "raw": "{\"summary\":\"b\"}",
      "value": "{\"summary\":\"b\"}",
      "status": "voted",
      "weight": null
     }
    ]
   },
   "expect": {
    "text": "{\"member_2\":\"b\"}",
    "fields": [
     {
      "field": "summary",
      "rule": "project",
      "values": {
       "member_2": "b"
      },
      "result": null
     }
    ]
   }
  },
