{
 "op": "boxed@1",
 "stage": "extract",
 "cases": [
  {"name": "last of two", "args": {},
   "input": "\\boxed{1} then \\boxed{2}",
   "expect": {"status": "voted", "value": "2"}},
  {"name": "nested frac", "args": {},
   "input": "\\boxed{\\frac{1}{2}}",
   "expect": {"status": "voted", "value": "\\frac{1}{2}"}},
  {"name": "empty box", "args": {},
   "input": "\\boxed{}",
   "expect": {"status": "empty", "value": null}},
  {"name": "unclosed", "args": {},
   "input": "\\boxed{12",
   "expect": {"status": "empty", "value": null}},
  {"name": "no box", "args": {},
   "input": "no box",
   "expect": {"status": "empty", "value": null}},
  {"name": "depth 8 total", "args": {},
   "input": "\\boxed{{{{{{{{x}}}}}}}}",
   "expect": {"status": "voted", "value": "{{{{{{{x}}}}}}}"}},
  {"name": "depth 9 total", "args": {},
   "input": "\\boxed{{{{{{{{{x}}}}}}}}}",
   "expect": {"status": "empty", "value": null}},
  {"name": "spaces kept", "args": {},
   "input": "\\boxed{ 5 }",
   "expect": {"status": "voted", "value": " 5 "}},
  {"name": "backslash does not escape a brace", "args": {},
   "input": "\\boxed{a\\}b}",
   "expect": {"status": "voted", "value": "a\\"}},
  {"name": "unclosed last box beats closed earlier", "args": {},
   "input": "\\boxed{1} \\boxed{2",
   "expect": {"status": "empty", "value": null}}
 ]
}
