{
 "op": "regex@1",
 "stage": "extract",
 "cases": [
  {
   "name": "last match wins by default",
   "input": "Final: A\nFinal: B",
   "args": {
    "pattern": "Final: (\\w+)",
    "group": 1
   },
   "expect": {
    "status": "voted",
    "value": "B"
   }
  },
  {
   "name": "first occurrence on request",
   "input": "Final: A\nFinal: B",
   "args": {
    "pattern": "Final: (\\w+)",
    "group": 1,
    "occurrence": "first"
   },
   "expect": {
    "status": "voted",
    "value": "A"
   }
  },
  {
   "name": "group 0 is the whole match",
   "input": "Final: A\nFinal: B",
   "args": {
    "pattern": "Final: (\\w+)"
   },
   "expect": {
    "status": "voted",
    "value": "Final: B"
   }
  },
  {
   "name": "no match",
   "input": "no marker here",
   "args": {
    "pattern": "Final: (\\w+)",
    "group": 1
   },
   "expect": {
    "status": "no_match",
    "value": null
   }
  },
  {
   "name": "window drops the first character of the match",
   "input": "Final: ",
   "args": {
    "pattern": "Final: ([A-Z])",
    "group": 1
   },
   "expect": {
    "status": "no_match",
    "value": null
   }
  },
  {
   "name": "window keeps the last 1024 characters",
   "input": "Final: ",
   "args": {
    "pattern": "Final: ([A-Z])",
    "group": 1
   },
   "expect": {
    "status": "voted",
    "value": "A"
   }
  },
  {
   "name": "window excludes older text",
   "input": "Final: ",
   "args": {
    "pattern": "Final: ([A-Z])",
    "group": 1
   },
   "expect": {
    "status": "no_match",
    "value": null
   }
  },
  {
   "name": "ignore case keeps the text case",
   "input": "FINAL: B",
   "args": {
    "pattern": "final: (b)",
    "group": 1,
    "ignore_case": true
   },
   "expect": {
    "status": "voted",
    "value": "B"
   }
  },
  {
   "name": "named group",
   "input": "C) because",
   "args": {
    "pattern": "(?P<ans>[A-D])\\)",
    "group": "ans"
   },
   "expect": {
    "status": "voted",
    "value": "C"
   }
  },
  {
   "name": "empty group is empty",
   "input": "xy",
   "args": {
    "pattern": "x(a*)y",
    "group": 1
   },
   "expect": {
    "status": "empty",
    "value": null
   }
  },
  {
   "name": "blank group is empty",
   "input": "A:   ",
   "args": {
    "pattern": "A:(\\s*)",
    "group": 1
   },
   "expect": {
    "status": "empty",
    "value": null
   }
  },
  {
   "name": "group that did not take part is empty",
   "input": "b",
   "args": {
    "pattern": "(a)|b",
    "group": 1
   },
   "expect": {
    "status": "empty",
    "value": null
   }
  },
  {
   "name": "pattern does not compile",
   "input": "a",
   "args": {
    "pattern": "("
   },
   "expect": {
    "error": "combine_spec_invalid"
   }
  },
  {
   "name": "empty pattern",
   "input": "a",
   "args": {
    "pattern": ""
   },
   "expect": {
    "error": "combine_spec_invalid"
   }
  },
  {
   "name": "group out of range",
   "input": "a",
   "args": {
    "pattern": "(a)",
    "group": 2
   },
   "expect": {
    "error": "combine_spec_invalid"
   }
  },
  {
   "name": "unknown group name",
   "input": "a",
   "args": {
    "pattern": "(a)",
    "group": "name"
   },
   "expect": {
    "error": "combine_spec_invalid"
   }
  },
  {
   "name": "unknown arg",
   "input": "a",
   "args": {
    "pattern": "a",
    "flags": "i"
   },
   "expect": {
    "error": "combine_spec_invalid"
   }
  },
  {
   "name": "word class is ASCII: no word at the end",
   "input": "name Ü",
   "args": {
    "pattern": "(\\w+)$",
    "group": 1
   },
   "expect": {
    "status": "no_match",
    "value": null
   }
  },
  {
   "name": "word class is ASCII: the last word",
   "input": "name Ü",
   "args": {
    "pattern": "(\\w+)",
    "group": 1
   },
   "expect": {
    "status": "voted",
    "value": "name"
   }
  },
  {
   "name": "letter property reads Unicode",
   "input": "name Ü",
   "args": {
    "pattern": "(\\p{L}+)$",
    "group": 1
   },
   "expect": {
    "status": "voted",
    "value": "Ü"
   }
  },
  {
   "name": "digit class is ASCII",
   "input": "total １２",
   "args": {
    "pattern": "(\\d+)",
    "group": 1
   },
   "expect": {
    "status": "no_match",
    "value": null
   }
  },
  {
   "name": "number property reads Unicode",
   "input": "total １２",
   "args": {
    "pattern": "(\\p{N}+)",
    "group": 1
   },
   "expect": {
    "status": "voted",
    "value": "１２"
   }
  },
  {
   "name": "ignore case folds unicode",
   "input": "Ü",
   "args": {
    "pattern": "(ü)",
    "group": 1,
    "ignore_case": true
   },
   "expect": {
    "status": "voted",
    "value": "Ü"
   }
  },
  {
   "name": "nested quantifier runs in linear time",
   "input": "!",
   "args": {
    "pattern": "(a+){10}$"
   },
   "expect": {
    "status": "no_match",
    "value": null
   }
  },
  {
   "name": "quantified alternation runs in linear time",
   "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!",
   "args": {
    "pattern": "(a|aa)+$"
   },
   "expect": {
    "status": "no_match",
    "value": null
   }
  },
  {
   "name": "adjacent unbounded repeats run in linear time",
   "input": "111111111111111111111111111111",
   "args": {
    "pattern": "\\d*\\d*\\d*x"
   },
   "expect": {
    "status": "no_match",
    "value": null
   }
  },
  {
   "name": "backreference does not compile",
   "input": "a",
   "args": {
    "pattern": "(a)\\1"
   },
   "expect": {
    "error": "combine_spec_invalid"
   }
  },
  {
   "name": "lookahead does not compile",
   "input": "a",
   "args": {
    "pattern": "(?=a)"
   },
   "expect": {
    "error": "combine_spec_invalid"
   }
  },
  {
   "name": "lookbehind does not compile",
   "input": "a",
   "args": {
    "pattern": "(?<=a)b"
   },
   "expect": {
    "error": "combine_spec_invalid"
   }
  },
  {
   "name": "repeat over the RE2 limit does not compile",
   "input": "a",
   "args": {
    "pattern": "a{1,9999}"
   },
   "expect": {
    "error": "combine_spec_invalid"
   }
  }
 ]
}
