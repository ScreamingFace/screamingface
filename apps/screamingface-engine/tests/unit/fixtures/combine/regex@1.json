{
 "op": "regex@1",
 "stage": "extract",
 "cases": [
  {"name": "last match wins by default", "args": {"pattern": "Final: (\\w+)", "group": 1},
   "input": "Final: A\nFinal: B",
   "expect": {"status": "voted", "value": "B"}},
  {"name": "first occurrence on request", "args": {"pattern": "Final: (\\w+)", "group": 1, "occurrence": "first"},
   "input": "Final: A\nFinal: B",
   "expect": {"status": "voted", "value": "A"}},
  {"name": "group 0 is the whole match", "args": {"pattern": "Final: (\\w+)"},
   "input": "Final: A\nFinal: B",
   "expect": {"status": "voted", "value": "Final: B"}},
  {"name": "no match", "args": {"pattern": "Final: (\\w+)", "group": 1},
   "input": "no marker here",
   "expect": {"status": "no_match", "value": null}},
  {"name": "window drops the first character of the match", "args": {"pattern": "Final: ([A-Z])", "group": 1},
   "input": "Final: ",
   "expect": {"status": "no_match", "value": null}},
  {"name": "window keeps the last 1024 characters", "args": {"pattern": "Final: ([A-Z])", "group": 1},
   "input": "Final: ",
   "expect": {"status": "voted", "value": "A"}},
  {"name": "named group", "args": {"pattern": "(?P<ans>[A-D])\\)", "group": "ans"},
   "input": "C) because",
   "expect": {"status": "voted", "value": "C"}},
  {"name": "blank group is empty", "args": {"pattern": "A:(\\s*)", "group": 1},
   "input": "A:   ",
   "expect": {"status": "empty", "value": null}},
  {"name": "group that did not take part is empty", "args": {"pattern": "(a)|b", "group": 1},
   "input": "b",
   "expect": {"status": "empty", "value": null}},
  {"name": "empty pattern", "args": {"pattern": ""},
   "input": "a",
   "expect": {"error": "combine_spec_invalid"}},
  {"name": "group out of range", "args": {"pattern": "(a)", "group": 2},
   "input": "a",
   "expect": {"error": "combine_spec_invalid"}},
  {"name": "unknown group name", "args": {"pattern": "(a)", "group": "name"},
   "input": "a",
   "expect": {"error": "combine_spec_invalid"}},
  {"name": "unknown arg", "args": {"pattern": "a", "flags": "i"},
   "input": "a",
   "expect": {"error": "combine_spec_invalid"}},
  {"name": "letter property reads Unicode", "args": {"pattern": "(\\p{L}+)$", "group": 1},
   "input": "name Ü",
   "expect": {"status": "voted", "value": "Ü"}},
  {"name": "digit class is ASCII", "args": {"pattern": "(\\d+)", "group": 1},
   "input": "total １２",
   "expect": {"status": "no_match", "value": null}},
  {"name": "ignore case folds unicode", "args": {"pattern": "(ü)", "group": 1, "ignore_case": true},
   "input": "Ü",
   "expect": {"status": "voted", "value": "Ü"}},
  {"name": "nested quantifier runs in linear time", "args": {"pattern": "(a+){10}$"},
   "input": "!",
   "expect": {"status": "no_match", "value": null}},
  {"name": "quantified alternation runs in linear time", "args": {"pattern": "(a|aa)+$"},
   "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!",
   "expect": {"status": "no_match", "value": null}},
  {"name": "backreference does not compile", "args": {"pattern": "(a)\\1"},
   "input": "a",
   "expect": {"error": "combine_spec_invalid"}},
  {"name": "lookahead does not compile", "args": {"pattern": "(?=a)"},
   "input": "a",
   "expect": {"error": "combine_spec_invalid"}},
  {"name": "repeat over the RE2 limit does not compile", "args": {"pattern": "a{1,9999}"},
   "input": "a",
   "expect": {"error": "combine_spec_invalid"}}
 ]
}
