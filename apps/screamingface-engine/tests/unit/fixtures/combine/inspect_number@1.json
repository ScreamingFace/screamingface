{
 "op": "inspect_number@1",
 "stage": "extract",
 "cases": [
  {
   "name": "currency and thousands separator",
   "input": "The total is $1,200.",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "1200"
   }
  },
  {
   "name": "assignment is not a number word",
   "input": "x=42",
   "args": {},
   "expect": {
    "status": "empty",
    "value": null
   }
  },
  {
   "name": "enclosing parentheses are kept",
   "input": "(42)",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "(42)"
   }
  },
  {
   "name": "the last number word wins",
   "input": "12 apples, then 7 more",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "7"
   }
  },
  {
   "name": "no number",
   "input": "no number here",
   "args": {},
   "expect": {
    "status": "empty",
    "value": null
   }
  },
  {
   "name": "trailing period",
   "input": "9.",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "9"
   }
  },
  {
   "name": "markdown emphasis",
   "input": "**42**",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "42"
   }
  },
  {
   "name": "unicode minus",
   "input": "−5",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "−5"
   }
  },
  {
   "name": "full-width digits",
   "input": "１２",
   "args": {},
   "expect": {
    "status": "voted",
    "value": "１２"
   }
  },
  {
   "name": "too large for a float",
   "input": "1e999",
   "args": {},
   "expect": {
    "status": "empty",
    "value": null
   }
  }
 ]
}
