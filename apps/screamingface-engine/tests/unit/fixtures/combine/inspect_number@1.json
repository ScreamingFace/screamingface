{
 "op": "inspect_number@1",
 "stage": "extract",
 "cases": [
  {"name": "currency and thousands separator", "args": {},
   "input": "The total is $1,200.",
   "expect": {"status": "voted", "value": "1200"}},
  {"name": "assignment is not a number word", "args": {},
   "input": "x=42",
   "expect": {"status": "empty", "value": null}},
  {"name": "enclosing parentheses are kept", "args": {},
   "input": "(42)",
   "expect": {"status": "voted", "value": "(42)"}},
  {"name": "the last number word wins", "args": {},
   "input": "12 apples, then 7 more",
   "expect": {"status": "voted", "value": "7"}},
  {"name": "no number", "args": {},
   "input": "no number here",
   "expect": {"status": "empty", "value": null}},
  {"name": "trailing period", "args": {},
   "input": "9.",
   "expect": {"status": "voted", "value": "9"}},
  {"name": "markdown emphasis", "args": {},
   "input": "**42**",
   "expect": {"status": "voted", "value": "42"}},
  {"name": "unicode minus", "args": {},
   "input": "−5",
   "expect": {"status": "voted", "value": "−5"}},
  {"name": "full-width digits", "args": {},
   "input": "１２",
   "expect": {"status": "voted", "value": "１２"}},
  {"name": "too large for a float", "args": {},
   "input": "1e999",
   "expect": {"status": "empty", "value": null}}
 ]
}
