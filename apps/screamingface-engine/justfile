# Engine recipes. Mounted in the repo-root justfile as `engine`, so from the root:
#
#   just engine benchmark-bump draco-3pass

set default-list := true

# Print what moving a Benchmark's published revision costs, and the lines to edit (OME-1610).
# Edits nothing: the move is a hand edit in a reviewed PR, with the owner's sign-off.
# WHY --isolated: a throwaway env from uv's cache keeps the inspect extra out of .venv, where it
# would fail the pre-push hook's two import-cost tests (CI runs without the extra).
benchmark-bump key:
    uv run --isolated --extra inspect python scripts/benchmark_bump.py {{ key }}
