        <mxCell id="lane2" value="ScreamingFace: the same five steps, cut by five seams. Each seam is a hand-off, and each hand-off needs a name, a contract and a proof." style="swimlane;startSize=36;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=13;fontStyle=1;swimlaneFillColor=#0f1522;" vertex="1" parent="1">
