        <mxCell id="1" parent="0" />
        <mxCell id="ttl" value="Why inspect is one call and we are many parts: the same five steps, with and without seams" style="text;html=1;align=left;verticalAlign=middle;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="30" as="geometry" />
        </mxCell>

        <mxCell id="lane1" value="inspect: Task + eval(). One Python process, one laptop, one owner. Nothing changes hands, so nothing needs a name." style="swimlane;startSize=36;html=1;fillColor=#1a2233;strokeColor=#8b98ab;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=13;fontStyle=1;swimlaneFillColor=#0f1522;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1380" height="230" as="geometry" />
        </mxCell>
        <mxCell id="proc" value="one coroutine per Sample: task_run_sample, run.py#L2103. The Sample object stays in memory from load to log." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#8b98ab;fontColor=#9fb0c3;fontFamily=Courier New;fontSize=11;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="lane1">
          <mxGeometry x="30" y="50" width="1320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="i1" value="load the Samples&#xa;hf_dataset() at run time,&#xa;Sample(input, target, choices)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;" vertex="1" parent="lane1">
          <mxGeometry x="60" y="90" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="build the prompt&#xa;the solver chain,&#xa;on the same Sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;" vertex="1" parent="lane1">
          <mxGeometry x="330" y="90" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="i3" value="call the model&#xa;generate() bound to the one Model,&#xa;run.py#L1187; keys in the env" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33240a;strokeColor=#e8b339;fontColor=#fef3c7;fontFamily=Courier New;fontSize=12;" vertex="1" parent="lane1">
