        <mxCell id="title" value="ADDING A BENCHMARK — the 8 steps and what you touch" style="text;html=1;align=left;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="STEP 0 — pick your cell&#xa;&#xa;no files — two decisions&#xa;&#xa;interaction × failure_policy&#xa;(+ the grading method label)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a2233;strokeColor=#8b98ab;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="310" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="STEP 1 — the board module&#xa;&#xa;NEW dir: benchmarks/&amp;lt;board&amp;gt;/&#xa;&#xa;pins · prepare · definition ·&#xa;runtime · aggregate · helpers&#xa;— everything you own lives here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
