        </mxCell>
        <mxCell id="s2" value="STEP 2 — bake the assets&#xa;&#xa;prepare.py + pins.py&#xa;&#xa;dataset → cases.json (public)&#xa;+ private answer key / rubric,&#xa;at image build time only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0a2b1e;strokeColor=#34d399;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="70" width="310" height="130" as="geometry" />
