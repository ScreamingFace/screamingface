        </mxCell>
        <mxCell id="prodDB" value="production Postgres — request_cache_entries&#xa;~204,765 rows: every raw paid model reply,&#xa;each stored under a key_hash (sha256 of its request)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#221a33;strokeColor=#a78bfa;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;" vertex="1" parent="lane1">
