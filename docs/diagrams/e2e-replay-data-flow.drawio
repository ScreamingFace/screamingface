        </mxCell>

        <!-- ===== Lane 3: BLESS RUN ===== -->
        <mxCell id="lane3" value="BLESS RUN — slice_snapshot.py, everything local + throwaway (Docker on your machine)" style="swimlane;startSize=30;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;swimlaneFillColor=#0d1424;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="1480" height="560" as="geometry" />
        </mxCell>
        <mxCell id="parse" value="Stage 1 PARSE&#xa;stream the dump's COPY rows once;&#xa;index payloads by answer text;&#xa;archive → question→answer map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;" vertex="1" parent="lane3">
