          <mxGeometry x="40" y="270" width="1480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="archive" value="archive eval JSONL (.eval.jsonl)&#xa;the original run's results:&#xa;question → candidate answer text" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#2e250f;strokeColor=#d7b357;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;" vertex="1" parent="lane2">
          <mxGeometry x="200" y="50" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dump" value="production cache dump (.sql.gz)&#xa;full pg_dump, 204,765 rows —&#xa;judge replies usable as-is; candidate rows&#xa;keyed by a legacy harness (wrong keys)" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#2e250f;strokeColor=#d7b357;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;" vertex="1" parent="lane2">
