        </mxCell>
        <mxCell id="engine" value="real benchmark engine + SDK&#xa;runs the board KEYLESSLY&#xa;(twice: capture, then verify)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;" vertex="1" parent="lane3">
          <mxGeometry x="430" y="60" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="proxy" value="recording proxy (loopback)&#xa;records every rendered&#xa;candidate request body" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e250f;strokeColor=#d7b357;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;" vertex="1" parent="lane3">
          <mxGeometry x="760" y="60" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="real AI Gateway (local, loopback)&#xa;NO API KEYS — cannot reach providers,&#xa;cannot spend a cent; serves cache only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33240a;strokeColor=#e8b339;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;" vertex="1" parent="lane3">
          <mxGeometry x="1100" y="60" width="310" height="100" as="geometry" />
        </mxCell>
        <mxCell id="helper" value="gateway's OWN key math&#xa;build_global_cache_plan&#xa;(subprocess in the aigateway venv —&#xa;hashing never re-implemented)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0a2b1e;strokeColor=#34d399;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;" vertex="1" parent="lane3">
          <mxGeometry x="760" y="330" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="FRESH throwaway Postgres&#xa;Docker testcontainer on your machine —&#xa;created for this run, DELETED at the end" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#221a33;strokeColor=#a78bfa;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;" vertex="1" parent="lane3">
          <mxGeometry x="1100" y="330" width="310" height="110" as="geometry" />
        </mxCell>
        <mxCell id="slice" value="Stage 6 SLICE (observation, not curation)&#xa;rows whose hit_count moved during the&#xa;verified replay = the fixture&#xa;(11,902 of 204,765)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;" vertex="1" parent="lane3">
