<?xml version="1.0" encoding="UTF-8"?><mxfile host="drawio"><diagram name="architecture"><mxGraphModel background="#0a0f1c" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;IMPORT&lt;/b&gt; — once, when a developer imports the eval" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#9fb0c3;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;IMAGE BUILD&lt;/b&gt; — every time the image is built" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#9fb0c3;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="900" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;choose the preparation path ✅ CHANGED&lt;/b&gt;&lt;br&gt;Hugging Face reader first; its four &quot;can&#x27;t see the fetch&quot; refusals route onward&lt;br&gt;&lt;i&gt;importer.py&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#14532d;strokeColor=#30a46c;fontColor=#dcfce7;strokeWidth=2;fontSize=12;fontFamily=Courier New;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="310" height="130" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Task replay, in a child process ✅ NEW&lt;/b&gt;&lt;br&gt;calls ONLY the eval&#x27;s task function, so its loaders fetch the Cases; empty cache&lt;br&gt;&lt;i&gt;task_replay.py&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#14532d;strokeColor=#30a46c;fontColor=#dcfce7;strokeWidth=2;fontSize=12;fontFamily=Courier New;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="310" height="130" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Case Source recorder ✅ NEW&lt;/b&gt;&lt;br&gt;pass-through wrap on every Inspect, inspect_evals and datasets fetch&lt;br&gt;&lt;i&gt;task_replay.py&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#14532d;strokeColor=#30a46c;fontColor=#dcfce7;strokeWidth=2;fontSize=12;fontFamily=Courier New;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="310" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Case Digest, taken twice ✅ NEW&lt;/b&gt;&lt;br&gt;sha256 of the prepared Cases; both runs must agree&lt;br&gt;&lt;i&gt;task_replay.py&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#14532d;strokeColor=#30a46c;fontColor=#dcfce7;strokeWidth=2;fontSize=12;fontFamily=Courier New;spacing=8;" vertex="1" parent="1"><mxGeometry x="1480" y="70" width="310" height="130" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;generated declaration ✅ CHANGED&lt;/b&gt;&lt;br&gt;task + args, Case count, Case Digest, licence TODO, Case Sources as comments&lt;br&gt;&lt;i&gt;importer.py → prepare.py&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#14532d;strokeColor=#30a46c;fontColor=#dcfce7;strokeWidth=2;fontSize=12;fontFamily=Courier New;spacing=8;" vertex="1" parent="1"><mxGeometry x="1960" y="70" width="310" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;👤 import review&lt;/b&gt;&lt;br&gt;COPIED, CAPTURED, OURS + owner licence decision&lt;br&gt;&lt;i&gt;the PR diff&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#78350f;strokeColor=#f5a524;fontColor=#fef3c7;strokeWidth=2;fontSize=12;fontFamily=Courier New;spacing=8;" vertex="1" parent="1"><mxGeometry x="2440" y="70" width="310" height="130" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Task-replay Case Preparation ✅ NEW&lt;/b&gt;&lt;br&gt;calls the task function again in a child process; same prompt rendering and writer&lt;br&gt;&lt;i&gt;prepare.py&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#14532d;strokeColor=#30a46c;fontColor=#dcfce7;strokeWidth=2;fontSize=12;fontFamily=Courier New;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="310" height="130" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Case Digest check ✅ NEW&lt;/b&gt;&lt;br&gt;match: write the Cases; differ or fetch fails: SKIPPED + reason&lt;br&gt;&lt;i&gt;prepare.py&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#14532d;strokeColor=#30a46c;fontColor=#dcfce7;strokeWidth=2;fontSize=12;fontFamily=Courier New;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="360" width="310" height="130" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;🗄️ prepared Cases in the image&lt;/b&gt;&lt;br&gt;Case inputs + Grading Material files&lt;br&gt;&lt;i&gt;/opt/benchmarks&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#4c1d95;strokeColor=#a06ed4;fontColor=#ede9fe;strokeWidth=2;fontSize=12;fontFamily=Courier New;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="350" width="310" height="150" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Benchmark Revision ✅ CHANGED&lt;/b&gt;&lt;br&gt;now includes the Case Digest&lt;br&gt;&lt;i&gt;benchmarks.py&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#14532d;strokeColor=#30a46c;fontColor=#dcfce7;strokeWidth=2;fontSize=12;fontFamily=Courier New;spacing=8;" vertex="1" parent="1"><mxGeometry x="1960" y="360" width="310" height="130" as="geometry"/></mxCell><mxCell id="c14" value="agieval lsat-ar:&lt;br&gt;no hf_dataset&lt;br&gt;binding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#9fb0c3;strokeWidth=1.5;fontColor=#dbe4f0;labelBackgroundColor=#0a0f1c;fontSize=12;fontFamily=Courier New;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="fetches&lt;br&gt;lsat-ar.jsonl&lt;br&gt;at GitHub commit&lt;br&gt;84ab72d9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#9fb0c3;strokeWidth=1.5;fontColor=#dbe4f0;labelBackgroundColor=#0a0f1c;fontSize=12;fontFamily=Courier New;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="one Case Source&lt;br&gt;per fetch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#9fb0c3;strokeWidth=1.5;fontColor=#dbe4f0;labelBackgroundColor=#0a0f1c;fontSize=12;fontFamily=Courier New;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="Case count +&lt;br&gt;Case Digest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#9fb0c3;strokeWidth=1.5;fontColor=#dbe4f0;labelBackgroundColor=#0a0f1c;fontSize=12;fontFamily=Courier New;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="diff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#9fb0c3;strokeWidth=1.5;fontColor=#dbe4f0;labelBackgroundColor=#0a0f1c;fontSize=12;fontFamily=Courier New;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="merged; image build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#9fb0c3;strokeWidth=1.5;fontColor=#dbe4f0;labelBackgroundColor=#0a0f1c;fontSize=12;fontFamily=Courier New;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2595.0" y="540"/><mxPoint x="195.0" y="540"/></Array></mxGeometry></mxCell><mxCell id="c20" value="recomputed&lt;br&gt;Case Digest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#9fb0c3;strokeWidth=1.5;fontColor=#dbe4f0;labelBackgroundColor=#0a0f1c;fontSize=12;fontFamily=Courier New;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="same digest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#9fb0c3;strokeWidth=1.5;fontColor=#dbe4f0;labelBackgroundColor=#0a0f1c;fontSize=12;fontFamily=Courier New;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="Case Digest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#9fb0c3;strokeWidth=1.5;fontColor=#dbe4f0;labelBackgroundColor=#0a0f1c;fontSize=12;fontFamily=Courier New;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Files are relative to &lt;i&gt;apps/screamingface-engine/src/screamingface_engine_inspect/&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#9fb0c3;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="565" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Task replay never runs an evaluation:&lt;/b&gt; it calls the eval&#x27;s &lt;i&gt;@task&lt;/i&gt; function, which builds a Task and loads its dataset. It never calls inspect&#x27;s &lt;i&gt;eval()&lt;/i&gt;, so no solver, scorer, model or Judge runs, and nothing is paid for." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#fef3c7;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="595" width="2200" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
