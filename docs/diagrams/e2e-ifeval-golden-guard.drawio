        <mxCell id="a2" value="sf.evaluate(&quot;ifeval&quot;)&#xa;one call grades an exam&#xa;of 50 questions" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=12;fontColor=#dbe4f0;fillColor=#0c2530;strokeColor=#2dd4bf;" vertex="1" parent="laneA">
