        <mxCell id="title" value="How one paid ifeval run becomes a FREE, permanent guard for the example notebooks" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Courier New;fontSize=17;fontStyle=1;fontColor=#dbe4f0;" vertex="1" parent="1">
