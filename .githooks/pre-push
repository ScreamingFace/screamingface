#!/bin/sh
# Heavy per-stack quality gates before pushing: run_gates.py for each stack whose root
# changed on this branch vs the merge base with the remote's main. Keeps pytest/pyright/coverage
# off the per-commit path while still gating what leaves the machine.
#
# The base is a REMOTE's main, never a local `main`: a local main that lags the remote makes
# every remote commit since look like this branch's change, so a docs-only push gated every
# stack those commits touched. The remote is found by history, not by name: among every
# <remote>/main, the one this branch has the fewest commits on top of is the main it was cut
# from. Example: 1 commit ahead of sc-remote/main but 41 ahead of a fork's stale origin/main
# -> sc-remote/main. A branch cut from another branch is still compared with main, so its
# parent's stacks are gated too: slower, never missed.
base=""
fewest=""
for ref in $(git for-each-ref --format='%(refname:short)' 'refs/remotes/*/main'); do
  ahead=$(git rev-list --count "$ref..HEAD" 2>/dev/null) || continue
  if [ -z "$fewest" ] || [ "$ahead" -lt "$fewest" ]; then
    base="$ref"
    fewest="$ahead"
  fi
done
if [ -z "$base" ]; then
  echo "pre-push: found no <remote>/main to compare this branch against." >&2
  echo "pre-push: fetch your remote's main (git fetch <remote>) and push again." >&2
  exit 1
fi
changed=$(git diff --name-only "$base"...HEAD 2>/dev/null)

fail=0
run_stack() {
  root="$1"; stack="$2"
  if printf '%s\n' "$changed" | grep -q "^$root/"; then
    echo ">> gates: $stack"
    uv run .claude/scripts/run_gates.py "$stack" --base "$base" || fail=1
  fi
}
run_stack apps/aigateway aigateway
run_stack apps/aigateway-ui aigateway-ui
run_stack apps/scoreboard scoreboard
run_stack packages/url4 url4
run_stack apps/screamingface-engine screamingface-engine
exit $fail
